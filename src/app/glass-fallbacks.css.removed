/* Removed from globals.css on request — see the note at the top of the glass
   section. Paste this back above the scaling-bands block to restore it. */

/* ---------------------------------------------------------------------------
   Two ways out of the glass, both of them the user's decision rather than ours.

   `prefers-reduced-transparency` is set by someone who finds translucent interfaces
   hard to read, and honouring it means opaque surfaces, not slightly-less-blurry
   ones. `@supports not` catches the browsers that cannot do it at all, where a
   translucent fill with no blur behind it is just washed-out text.
   --------------------------------------------------------------------------- */

@media (prefers-reduced-transparency: reduce) {
  .site-header,
  .site-header[data-on-dark='true'],
  .menu-panel,
  .capsule-note,
  .product-stamp,
  .button.secondary,
  .glass,
  .glass-surface {
    background-image: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header {
    background-color: rgb(var(--frost));
  }

  .site-header[data-on-dark='true'] {
    background-color: rgb(var(--abyss));
  }

  .menu-panel {
    background-color: rgb(var(--deep));
  }

  .capsule-note,
  .product-stamp {
    background-color: rgb(var(--abyss) / 0.94);
  }

  .menu-scrim {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background-color: rgb(0 0 0 / 0.55);
  }
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .site-header {
    background-color: rgb(var(--frost) / 0.97);
  }

  .site-header[data-on-dark='true'] {
    background-color: rgb(var(--abyss) / 0.95);
  }

  .menu-panel {
    background-color: rgb(var(--deep) / 0.98);
  }

  .capsule-note,
  .product-stamp {
    background-color: rgb(var(--abyss) / 0.86);
  }
}

